# =========================================================================
# Shared ignore rules for local development and deployment.
# Keep credentials, installed dependencies, runtime files, and scratch assets
# out of git.
# =========================================================================

# Local config (DB + SMTP credentials). NEVER commit.
config/local.php

# Composer dependencies - run `composer install` locally; Docker installs them.
/vendor/
composer.phar

# Fly.io local state
.fly/
fly.toml.bak

# Legacy local uploads dir - ID cards now live in DB as BLOBs,
# but older XAMPP runs may have leftover files on disk.
/uploads/

# Environment files
.env
.env.*
!.env.example

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*:Zone.Identifier
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak
*.orig
*.tmp

# PHP runtime junk
*.log
error_log
php_errors.log

# Temp files from merge/cherry-pick that should not be committed.
*.rej

# Local-only design briefs / scratch docs.
UI_BRIEF_SUBNAUTICA.*
*.scratch.md

# Python bytecode from local utility scripts.
__pycache__/
*.pyc

# Defensive - in case JS tooling is added later.
node_modules/

# Database dumps / backups; keep real data out of git.
*.sql.bak
*.sql.gz
*.dump

# IDE projects
*.iml
.project
.settings/
