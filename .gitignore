# =========================================================================
# thin-local branch — local XAMPP development only.
# Everything credential-bearing or environment-specific stays out of git.
# =========================================================================

# Local config (DB + SMTP credentials). NEVER commit.
config/local.php

# Composer dependencies — run `composer install` to restore.
/vendor/
composer.phar

# Legacy local uploads dir — ID cards now live in DB as BLOBs,
# but older XAMPP runs may have leftover files on disk. Never commit them.
/uploads/

# Environment files (in case anyone adds .env-style loading later)
.env
.env.*
!.env.example

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*:Zone.Identifier
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak
*.orig
*.tmp

# PHP runtime junk
*.log
error_log
php_errors.log

# Temp files from merge/cherry-pick that shouldn't be committed
*.rej

# Local-only design briefs / scratch docs (generated, not source-of-truth).
# Keep design discussions on Drive/Discord — binaries don't diff well.
UI_BRIEF_SUBNAUTICA.*
*.scratch.md

# Python bytecode (if anyone runs the doc-generator script locally)
__pycache__/
*.pyc

# Defensive — in case someone adds JS tooling later
node_modules/

# Database dumps / backups (keep production data out of git)
*.sql.bak
*.sql.gz
*.dump

# IDE projects (catches more than .vscode / .idea)
*.iml
.project
.settings/
